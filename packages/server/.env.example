# Copy to .env (never commit .env). All SCRAPPY_* are optional; defaults in parentheses.
OPENROUTER_API_KEY=
SCRAPPY_DATA_DIR=./data
SCRAPPY_CONFIG_DIR=./config
# SCRAPPY_DATABASE_URL=            (sqlite+aiosqlite:///<data_dir>/scrappy.db)
# SCRAPPY_ARCHIVE_DIR=             (<data_dir>/raw)
# SCRAPPY_LOG_LEVEL=INFO
SCRAPPY_LLM_MODEL=openai/gpt-4o-mini
# SCRAPPY_LLM_BASE_URL=https://openrouter.ai/api/v1
# SCRAPPY_LLM_TIMEOUT=60
# SCRAPPY_LLM_MAX_DESCRIPTION_CHARS=4000
# SCRAPPY_LLM_STRUCTURED_OUTPUT=true   (false = json_object + validation only)
# SCRAPPY_LLM_REFERER=
# SCRAPPY_LLM_APP_TITLE=olx_scrappy
# SCRAPPY_WORKER_POLL_INTERVAL=2
# SCRAPPY_WORKER_BATCH_SIZE=10
# SCRAPPY_PIPELINE_EXTRACT_AUTO=true
# SCRAPPY_PIPELINE_DISCOVERY_MAX_PAGES=100
# SCRAPPY_PIPELINE_RETRY_MAX_ATTEMPTS=5
